-- Recursive CTE to display the full category hierarchy.

WITH RECURSIVE category_tree AS (
    SELECT id,
           name,
           parent_id,
           name AS path,
           1 AS depth
    FROM categories
    WHERE parent_id IS NULL

    UNION ALL

    SELECT c.id,
           c.name,
           c.parent_id,
           ct.path || ' > ' || c.name AS path,
           ct.depth + 1
    FROM categories c
    JOIN category_tree ct ON c.parent_id = ct.id
)
SELECT id,
       name,
       parent_id,
       path,
       depth
FROM category_tree
ORDER BY path;
